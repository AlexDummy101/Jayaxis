rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /projects/{projectId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /news/{articleId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /quotation_requests/{requestId} {
      allow create: if request.resource.data.keys().hasOnly([
          'customer_name', 'phone', 'email', 'customer_company', 'item_requested',
          'inquiry_type', 'county', 'town', 'scope', 'ref_number', 'status', 'created_at'
        ])
        && request.resource.data.keys().hasAll([
          'customer_name', 'phone', 'item_requested', 'inquiry_type', 'county',
          'scope', 'ref_number', 'status', 'created_at'
        ])
        && request.resource.data.customer_name is string
        && request.resource.data.customer_name.size() >= 2
        && request.resource.data.customer_name.size() <= 120
        && request.resource.data.phone is string
        && request.resource.data.phone.size() >= 7
        && request.resource.data.phone.size() <= 40
        && request.resource.data.item_requested is string
        && request.resource.data.item_requested.size() <= 240
        && request.resource.data.inquiry_type is string
        && request.resource.data.county is string
        && request.resource.data.county.size() >= 2
        && request.resource.data.county.size() <= 120
        && request.resource.data.scope is string
        && request.resource.data.scope.size() <= 4000
        && request.resource.data.ref_number is string
        && request.resource.data.status == 'new'
        && request.resource.data.created_at == request.time
        && (!('email' in request.resource.data) || request.resource.data.email == null || request.resource.data.email is string)
        && (!('customer_company' in request.resource.data) || request.resource.data.customer_company == null || request.resource.data.customer_company is string)
        && (!('town' in request.resource.data) || request.resource.data.town == null || request.resource.data.town is string);
      allow read, update, delete: if isAdmin();
    }

    match /orders/{orderId} {
      allow create: if request.resource.data.keys().hasOnly([
          'id', 'order_ref', 'user_id', 'customer_name', 'customer_phone', 'customer_email',
          'customer_company', 'county', 'town', 'address', 'delivery_notes', 'items',
          'subtotal', 'payment_method', 'payment_phone', 'status', 'created_at'
        ])
        && request.resource.data.customer_name is string
        && request.resource.data.customer_name.size() >= 2
        && request.resource.data.customer_phone is string
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 100
        && request.resource.data.subtotal is number
        && request.resource.data.subtotal >= 0
        && request.resource.data.status == 'Pending Delivery'
        && request.resource.data.created_at is string;
      allow read, update, delete: if isAdmin();
    }

    match /users/{userId} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == userId);
      allow create: if isAdmin() || (
        request.auth != null
        && request.auth.uid == userId
        && request.resource.data.email == request.auth.token.email
      );
      allow update: if isAdmin() || (
        request.auth != null
        && request.auth.uid == userId
        && request.resource.data.email == resource.data.email
      );
      allow delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}